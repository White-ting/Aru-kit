# 心潮念网关的配置。复制一份改名成 .env（cp .env.example .env），再把下面的值改成你自己的。
# 每行写成 名字=值，# 开头的是注释。改完要重启网关才生效。

# ===== 网关自己 =====
# 网关听哪个端口。默认 8790。
PORT=8790
# 网关听哪个地址。默认 127.0.0.1（最安全）。给手机用时，用同一台机器上的隧道（cloudflared）或反代（Caddy、nginx）
# 套 HTTPS，这里照样写 127.0.0.1。别改成 0.0.0.0：防火墙一放行 8790，别人就能用明文 http 直连网关。
HOST=127.0.0.1
# App 里"API Key"那一栏填的就是这一串。自己编一串够长的随机字符，别和上游的钥匙一样。
# 可以用这条命令生成：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GATEWAY_KEY=换成你自己编的一长串

# ===== 上游（真正的模型）=====
# 上游的地址，写到 /v1 为止。可以是模型服务商，也可以是另一个网关（比如已经在用的记忆网关），叠着用。
UPSTREAM_URL=https://api.example.com/v1
# 上游的钥匙。只存在这里，不会给 App。
UPSTREAM_KEY=sk-换成上游的钥匙
#
# 只接 OpenAI 兼容格式。程序里还留着透传模式（UPSTREAM_KEY=passthrough）和按格式分上游（ANTHROPIC_UPSTREAM_*）的代码，
# 但没有真机测过、不提供（Aru 的订阅登录只肯发往 api.anthropic.com，走不了网关）。见 README「没有做的」。
#
# 【多个中转站】（0.1.4）在几家之间换着用的，每家写两行（名字只用大写字母和数字），App 的地址写 /<名字小写>/v1：
#   UPSTREAM_JUMENG_URL=https://聚梦的地址/v1
#   UPSTREAM_JUMENG_KEY=聚梦的钥匙
# 这样 App 地址写 https://你的地址/jumeng/v1 就走聚梦；写 https://你的地址/v1 还走上面的 UPSTREAM_URL。
# 想换哪家，在 App 里换地址就行，网关不用改、不用重启（加新的一家才要改 .env、重启一次）。

# ===== 心潮念 =====
# 心潮念的地址（不带 /v1）。
XINCHAO_URL=http://127.0.0.1:18110
# 心潮的服务口令，就是心潮 .env 里的 DYNAMIC_MIND_TOKEN。
XINCHAO_TOKEN=换成心潮的口令
# 每次找心潮最多等多少毫秒。超时就不等了，聊天照常。默认 3000。
XINCHAO_TIMEOUT_MS=3000

# ===== 两根线的开关 =====
# 第 2 根线"此刻"：她说话前报心跳、取此刻附在她这句后面。true 开，false 关。默认开。
NOW_ENABLED=true
# 第 3 根线"回传"：回复完以后把这一轮发给心潮。true 开，false 关。默认开。
EVENT_ENABLED=true
# 用户消息以这些开头的不算"她在说话"（桥、外部触发递进来的消息）。用 | 分隔。
SKIP_PREFIXES=【|〔心潮念
# 0.1.11：用户消息以这些开头的是工具结果（Aru 把工具取回的图另起一条用户消息发），当工具回合跟她那句配对，不当她说话。用 | 分隔。
TOOL_PREFIXES=Images returned by|Tool result|Tool output
# 0.1.14：TA 用来「说话」的工具。工具里的 text 算 TA 的回话，一起回传给心潮；只调了这类工具的那一轮，马上回传，不等工具走完。
#   Aru 的语音条是 generateVoice。用 | 分隔，不分大小写；留空 = 都当普通工具。
REPLY_TOOLS=generateVoice
# 只认流式请求（stream: true）。有的 App 会用同一个地址起标题、整理记忆，这些一般是非流式的；
# 打开这个能把它们排除掉，但如果你的 App 聊天本身就是非流式的，打开后两根线就都不工作了。默认 false。
ONLY_STREAM=false
# 后台杂活（起标题、摘要这类）不算"她在说话"，两条任一条成立就跳过：
#   1. 请求里 max_tokens 不超过这个数（起标题一般只要几十个字）。0 = 不看这条。默认 120。
BG_MAX_TOKENS=120
#   2. 请求里没有一条 AI 的回复（单发），而且系统提示或这句话里有下面这些词。用 | 分隔。
#      有前文时她说"帮我总结一下"照样算她在说话。不想要这条就留空：BG_PATTERNS=
BG_PATTERNS=标题|title|摘要|总结|概括|summar|关键词|keyword|标签|分类|classif

# ===== 节流（一般不用改）=====
# 此刻：内容没变时，多少分钟内不重复附。默认 0 = 每轮都附（0.1.3 起）。
#   网关只改发出去的那一份，Aru 这类 App 自己存的聊天记录里没有此刻；不每轮附，AI 只在附上的那一轮看得到。
#   你的 App 会把发出去的整份存进记录的，才改成 30。
NOW_REPEAT_MIN=0
# 此刻：她隔了多少分钟以上才说话，这一句一定附。默认 90。
NOW_FORCE_GAP_MIN=90
# 此刻：TA 看不看得到数值（0.1.15）。有的 AI 不喜欢看见数字，写 false：发给 TA 的此刻里「心跳 72」换成「心跳平稳」。
#   （不管写不写，那一行开头都会写成「身体（你自己的）：」，让 TA 知道是自己的心跳。）
#   你在心潮念网页上照样看得到。TA 自己调 xinchao_context 工具看到的数值，网关管不到。默认 true。
AI_SEES_NUMBERS=true
# 此刻怎么贴（0.1.16）。always = 每句都贴（默认，跟以前一样）。
#   signal = 临界点模式：不每句贴，只在这几种时候贴——有驱力新到了「涌」、情绪变了、冒出念头/还在气/矛盾/刚醒/睡着这几种行、
#   她隔了 NOW_FORCE_GAP_MIN 分钟以上才说的那一句。给不想被此刻带着走的 AI 用。
#   只管贴不贴：对话照常回传、心潮照常算、网页照常看、桥照常主动找。写了 signal 以后 NOW_REPEAT_MIN 不管用。
#   照此刻的文字判断（照心潮念 4.2 的写法），心潮念以后改了写法可能判不准。说明见 README「不想每句都给 TA 看此刻？」。
NOW_MODE=always
# 回传：她隔了多少分钟以上才说话，这一轮一定回传。默认 45。
EVENT_FORCE_GAP_MIN=45
# 回传：两次之间至少隔多少分钟。默认 8。
EVENT_MIN_INTERVAL_MIN=8
# 回传：每小时最多几次。默认 4。
EVENT_MAX_PER_HOUR=4

# ===== 其他 =====
# 请求体上限，单位 MB（发图片时是 base64，会比较大）。超了回 413。默认 20。
MAX_BODY_MB=20
# 节流状态存在哪个文件夹（一个很小的 json）。默认是网关文件夹下的 state/。
# STATE_DIR=./state
# 日志：info（默认）或 silent（什么都不打印）。日志里只有时间、步骤、成败、耗时、字数，没有聊天内容。
LOG_LEVEL=info
# 调试：1 = 日志里多记一行 shape，写她那句话的结构（分几块、每段几个字、前几条她的消息几个字、出现的 <标签> 名字），
#   不记正文。用来看 App 往她那句里塞了什么。看完改回 0。
#   写 2 再多记一行 skel：她那句话的骨架（标签名照写、属性值遮成 …、文字只留字数，比如 <sent_at>·4-·2</sent_at>⏎⏎·26），看附注是什么写法。
#   写 3（0.1.13）再多记几行 msg：最后 4 条消息每一块是什么（文字几个字、调了哪个工具、工具的字段名和字数、工具回执的类型和字数），
#   工具回合也记，最后一条另记骨架。不记任何内容和工具字段的值。用来查语音条那几轮为什么被当成工具回合。看完改回 0。
DEBUG_SHAPE=0
# App 塞进她那句的附注（0.1.4，0.1.6 照真机改）：Aru 在她那句后面加 <sent_at 2026-11-06 21:46>（单个标签），
# 带环境时再单独发一条 <environment>…</environment>。成对的整块去掉、单个的标签去掉；这一轮只剩附注的，不算她在说话。
# 回传给心潮、判断桥消息和后台杂活之前先整块去掉，发给模型的那份不动。
# * = 所有成对的 <英文标签>…</英文标签>（默认）；也可以只写几个：STRIP_TAGS=environment|sent_at；留空 = 不去。
STRIP_TAGS=*
